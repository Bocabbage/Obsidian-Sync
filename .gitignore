# This vault is synced by OneDrive. Git is a development history for
# agent rules, schemas, reusable views and formatting assets only.

# Ignore every top-level vault item by default, then allowlist below.
/*

# Root governance and reusable entry views
!/.gitignore
!/AGENTS.md
!/CLAUDE.md
!/README.md
!/卡片导航.md

# Agent skills and compatibility entrypoints; never track local permissions.
!/.agents/
!/.agents/**
.agents/**/.claude/
.agents/**/settings.local.json

!/.claude/
.claude/*
!/.claude/skills/
!.claude/skills/**
.claude/**/.claude/
.claude/**/settings.local.json

# Agent governance, contracts and maintenance records; session bodies stay OneDrive-only.
!/agents/
agents/*
!/agents/README.md
!/agents/docs/
agents/docs/*
!/agents/docs/vault-guide.md
!/agents/docs/_assets/
agents/docs/_assets/*
!/agents/docs/_assets/vault-guide/
agents/docs/_assets/vault-guide/*
!/agents/docs/_assets/vault-guide/directory-map.svg
!/agents/docs/_assets/vault-guide/directory-map.png
!/agents/docs/_assets/vault-guide/task-relations.svg
!/agents/docs/_assets/vault-guide/task-relations.png
!/agents/docs/_assets/vault-guide/knowledge-flow.svg
!/agents/docs/_assets/vault-guide/knowledge-flow.png
!/agents/schema/
!/agents/schema/**
!/agents/specs/
!/agents/specs/**
!/agents/migrations/
!/agents/migrations/**
agents/migrations/*.inventory.json
agents/migrations/*.verification.json
!/agents/backlog.md
!/agents/sessions/
agents/sessions/*
!/agents/sessions/_Index.md
!/agents/drafts/
agents/drafts/*
!/agents/drafts/README.md
!/agents/views/
agents/views/*
!/agents/views/README.md
!/agents/views/overview/
!/agents/views/overview/**

# Raw governance only; all source material and attachments stay OneDrive-only.
!/raws/
raws/*
!/raws/AGENTS.md

# Personal workspace framework and approved views
!/workspace/
workspace/*
!/workspace/AGENTS.md
!/workspace/README.md
!/workspace/plans/
workspace/plans/*
!/workspace/plans/README.md
!/workspace/plans/_Index.md
!/workspace/daily/
workspace/daily/*
!/workspace/daily/_Index.md
!/workspace/todos/
workspace/todos/*
!/workspace/todos/_Index.md
!/workspace/tasks/
workspace/tasks/*
!/workspace/tasks/_Index.md
!/workspace/themes/
workspace/themes/*
!/workspace/themes/_Index.md
!/workspace/learning/
workspace/learning/*
!/workspace/learning/AGENTS.md
!/workspace/learning/README.md
!/workspace/learning/_Index.md
!/workspace/insights/
workspace/insights/*
!/workspace/insights/_Index.md
!/workspace/reading/
workspace/reading/*
!/workspace/reading/README.md
!/workspace/_assets/
workspace/_assets/*
!/workspace/_assets/README.md

# Wiki routing skeleton only; compiled knowledge stays OneDrive-only.
!/wiki/
wiki/*
!/wiki/AGENTS.md
!/wiki/index.md
!/wiki/sources/
wiki/sources/*
!/wiki/sources/index.md
!/wiki/sources/books/
wiki/sources/books/*
!/wiki/sources/books/index.md
!/wiki/sources/movies/
wiki/sources/movies/*
!/wiki/sources/movies/index.md
!/wiki/sources/series/
wiki/sources/series/*
!/wiki/sources/series/index.md
!/wiki/sources/_views/
!/wiki/sources/_views/**
!/wiki/_assets/
wiki/_assets/*
!/wiki/_assets/README.md
!/wiki/computer-science/
wiki/computer-science/*
!/wiki/computer-science/AGENTS.md
!/wiki/computer-science/index.md
!/wiki/photography/
wiki/photography/*
!/wiki/photography/AGENTS.md
!/wiki/photography/index.md
!/wiki/language/
wiki/language/*
!/wiki/language/AGENTS.md
!/wiki/language/index.md
!/wiki/health/
wiki/health/*
!/wiki/health/AGENTS.md
!/wiki/health/index.md
!/wiki/cinema/
wiki/cinema/*
!/wiki/cinema/AGENTS.md
!/wiki/cinema/index.md

# Reusable formatting code only; UI state, themes and plugin data stay local.
!/.obsidian/
.obsidian/*
!/.obsidian/snippets/
!.obsidian/snippets/**

# Local Daily automation source only; no plugin settings or third-party bundles.
!/.obsidian/plugins/
.obsidian/plugins/*
!/.obsidian/plugins/vault-daily-todos/
.obsidian/plugins/vault-daily-todos/*
!/.obsidian/plugins/vault-daily-todos/manifest.json
!/.obsidian/plugins/vault-daily-todos/main.js
!/.obsidian/plugins/vault-daily-todos/model.cjs

# Operating-system and Obsidian transient files
.DS_Store
**/.DS_Store
.trash/
**/.trash/

# Task group framework only; personal groups and snapshots stay OneDrive-only.
!/workspace/task-groups/
workspace/task-groups/*
!/workspace/task-groups/_Index.md
!/.obsidian/plugins/vault-daily-todos/task-groups.cjs

# Exercise index only; individual exercise notes remain OneDrive-only.
!/workspace/exercises/
workspace/exercises/*
!/workspace/exercises/_Index.md
