# This vault is synced by OneDrive. Git is a development history for
# agent rules, schemas, reusable views and formatting assets only.

# Ignore every top-level vault item by default, then allowlist below.
/*

# Root governance and reusable entry views
!/.gitignore
!/AGENTS.md
!/CLAUDE.md
!/卡片导航.md

# Agent skills and compatibility entrypoints; never track local permissions.
!/.agents/
!/.agents/**
.agents/**/.claude/
.agents/**/settings.local.json

!/.claude/
.claude/*
!/.claude/skills/
!.claude/skills/**
.claude/**/.claude/
.claude/**/settings.local.json

# Active knowledge-system contracts and templates
!/schema/
!/schema/**

# Raw governance only; all source material and attachments stay OneDrive-only.
!/raws/
raws/*
!/raws/AGENTS.md

# Workspace framework, approved specs and migration control records
!/workspace/
workspace/*
!/workspace/AGENTS.md
!/workspace/README.md
!/workspace/backlog.md
!/workspace/specs/
!/workspace/specs/**
!/workspace/migrations/
!/workspace/migrations/**
!/workspace/drafts/
workspace/drafts/*
!/workspace/drafts/README.md
!/workspace/plans/
workspace/plans/*
!/workspace/plans/README.md
!/workspace/plans/_Index.md
!/workspace/daily/
workspace/daily/*
!/workspace/daily/_Index.md
!/workspace/tasks/
workspace/tasks/*
!/workspace/tasks/_Index.md
!/workspace/themes/
workspace/themes/*
!/workspace/themes/_Index.md
!/workspace/insights/
workspace/insights/*
!/workspace/insights/_Index.md
!/workspace/sessions/
workspace/sessions/*
!/workspace/sessions/_Index.md
!/workspace/overview.canvas
!/workspace/overview/
!/workspace/overview/**
!/workspace/reading/
workspace/reading/*
!/workspace/reading/README.md
!/workspace/_assets/
workspace/_assets/*
!/workspace/_assets/README.md

# Wiki routing skeleton only; compiled knowledge stays OneDrive-only.
!/wiki/
wiki/*
!/wiki/AGENTS.md
!/wiki/index.md
!/wiki/sources/
wiki/sources/*
!/wiki/sources/index.md
!/wiki/sources/books/
wiki/sources/books/*
!/wiki/sources/books/index.md
!/wiki/sources/movies/
wiki/sources/movies/*
!/wiki/sources/movies/index.md
!/wiki/sources/series/
wiki/sources/series/*
!/wiki/sources/series/index.md
!/wiki/sources/_views/
!/wiki/sources/_views/**
!/wiki/_assets/
wiki/_assets/*
!/wiki/_assets/README.md
!/wiki/computer-science/
wiki/computer-science/*
!/wiki/computer-science/AGENTS.md
!/wiki/computer-science/index.md
!/wiki/photography/
wiki/photography/*
!/wiki/photography/AGENTS.md
!/wiki/photography/index.md
!/wiki/language/
wiki/language/*
!/wiki/language/AGENTS.md
!/wiki/language/index.md
!/wiki/health/
wiki/health/*
!/wiki/health/AGENTS.md
!/wiki/health/index.md
!/wiki/cinema/
wiki/cinema/*
!/wiki/cinema/AGENTS.md
!/wiki/cinema/index.md

# Reusable formatting code only; UI state, themes and plugin data stay local.
!/.obsidian/
.obsidian/*
!/.obsidian/snippets/
!.obsidian/snippets/**

# Operating-system and Obsidian transient files
.DS_Store
**/.DS_Store
.trash/
**/.trash/
